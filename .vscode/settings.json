{
  "C_Cpp.intelliSenseEngine": "default",
  "idf.extensionActivationMode": "always",
  "idf.buildPath": "${workspaceFolder}/build/default",

  // Keep sdkconfig outside idf.buildPath so "Full Clean Project" (which deletes
  // the whole build directory) cannot take the project configuration with it.
  "idf.sdkconfigFilePath": "${workspaceFolder}/sdkconfig",
  "idf.flashType": "UART",
  "cmake.configureOnOpen": false,
  "cmake.configureOnEdit": false,
  "cmake.automaticReconfigure": false,
  "cmake.autoSelectActiveFolder": false,
  "cmake.options.advanced": {
    "build": {
      "statusBarVisibility": "inherit",
      "inheritDefault": "hidden"
    },
    "launch": {
      "statusBarVisibility": "inherit",
      "inheritDefault": "hidden"
    },
    "debug": {
      "statusBarVisibility": "inherit",
      "inheritDefault": "hidden"
    }
  },
  "files.associations": {
    "*.csv": "csv"
  },
  "idf.currentSetup": "/home/markus/.espressif/v6.1/esp-idf",
  "idf.customExtraVars": {
    "IDF_TARGET": "esp32"
  },
  "idf.port": "/dev/ttyUSB0"
}