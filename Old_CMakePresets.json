{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "IDF_TARGET": "esp32"
      }
    },
    {
      "name": "default",
      "inherits": "base",
      "displayName": "Default (development)",
      "description": "Development build: info-level logging, debug optimisation",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "SDKCONFIG": "${sourceDir}/build/default/sdkconfig",
        "SDKCONFIG_DEFAULTS": "${sourceDir}/sdkconfig.defaults",
        "IDF_TARGET": "esp32"
      }
    },
    {
      "name": "production",
      "inherits": "base",
      "displayName": "Production",
      "description": "Production build: size-optimised, warn-level logging",
      "binaryDir": "${sourceDir}/build/production",
      "cacheVariables": {
        "SDKCONFIG": "${sourceDir}/build/production/sdkconfig",
        "SDKCONFIG_DEFAULTS": "${sourceDir}/sdkconfig.defaults;${sourceDir}/sdkconfig.defaults.production"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "displayName": "Build (development)"
    },
    {
      "name": "production",
      "configurePreset": "production",
      "displayName": "Build (production)"
    }
  ]
}
